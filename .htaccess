
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS + non-www only on the live domain
    RewriteCond %{HTTP_HOST} ^(www\.)?drmedhasharma\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.drmedhasharma\.com$ [NC]
    RewriteRule ^ https://drmedhasharma.com%{REQUEST_URI} [R=301,L]

    # WordPress / PHP routing
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Block hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>